# =================================================================
# Career Readiness & Employability Platform - Environment Variables
# =================================================================

# -----------------------------------------------------------------
# 1. Supabase & Database Configuration (Required for Backend & DB)
# -----------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key (for client operations & auth verification)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (secret key with admin privileges for server-side admin ops)
# NOTE: Never expose this to client or client bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct/Pooled PostgreSQL Connection String (used for running schema migrations & seeds)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# -----------------------------------------------------------------
# 2. AI Service & Google Gemini Configuration (Required for AI)
# -----------------------------------------------------------------
# Google AI Studio / Gemini API Key for Gemini 3.5 Flash Lite
GOOGLE_API_KEY=your-google-gemini-api-key

# Embedding Model Identifier (e.g. models/text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004

# AI Service internal communication URL
AI_SERVICE_URL=http://localhost:8000

# -----------------------------------------------------------------
# 3. Application Server Settings
# -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
